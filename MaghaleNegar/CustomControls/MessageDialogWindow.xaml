<Window
    x:Class="MaghaleNegar.CustomControls.MessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    AllowsTransparency="True"
    Background="Transparent"
    FlowDirection="RightToLeft"
    FontFamily="Vazirmatn"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Border
            x:Name="cardBorder"
            MinWidth="340"
            MaxWidth="480"
            Background="White"
            CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="24"
                    Direction="270"
                    Opacity="0.35"
                    ShadowDepth="4"
                    Color="Black" />
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon
                    x:Name="iconMessage"
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Padding="15"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ExitBackgroundButton}"
                    Kind="Error" />

                <ScrollViewer
                    Grid.Row="0"
                    Grid.Column="1"
                    MaxHeight="320"
                    Margin="5"
                    VerticalAlignment="Center"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="lblMessage"
                        FontWeight="Bold"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <StackPanel
                    x:Name="panelButtons"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button x:Name="btn1" Margin="0,8,8,0" Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button x:Name="btn2" Margin="0,8,8,0" Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button x:Name="btn3" Margin="0,8,8,0" Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
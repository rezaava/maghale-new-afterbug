<UserControl
    x:Class="MaghaleNegar.Forms.JournalSettings.JournalSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="370"
    FlowDirection="RightToLeft"
    UseLayoutRounding="True"
    FontFamily="Vazirmatn"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeaderStyle" TargetType="Grid">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,3,0,8"/>
            </Style>

            <Style x:Key="HeaderLineStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="15,0"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBackgroundColor}"/>
                <Setter Property="Background" Value="{StaticResource LightBackgroundColor}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="panelMain">
        <Border
            Grid.RowSpan="2"
            Background="{StaticResource PrimaryBackgroundColor}"
            CornerRadius="10" />

        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- هدر -->
            <Grid
                Grid.Row="0"
                VerticalAlignment="Top"
                Background="{StaticResource PrimaryBackgroundColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btnCloseApp"
                            Width="30"
                            Height="30"
                            Margin="5"
                            Foreground="White"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            ToolTip="بستن پنجره">
                            <materialDesign:PackIcon Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Viewbox>

                <Viewbox Grid.Column="1" StretchDirection="DownOnly">
                    <TextBlock
                        x:Name="lblWindowName"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{StaticResource LightButtonTextColor}"
                        Text="مشخصات نشریه"
                        TextAlignment="Center" />
                </Viewbox>
            </Grid>

            <!-- بدنه -->
            <Border
                Grid.Row="1"
                Background="{StaticResource LightBackgroundColor}"
                CornerRadius="10">
                <Viewbox
                    Margin="5,0"
                    VerticalAlignment="Top"
                    StretchDirection="DownOnly">
                    <StackPanel Width="340">

                        <!-- عنوان نشریه -->
                        <StackPanel Margin="0,8,0,0">
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <Border Style="{StaticResource HeaderLineStyle}" Margin="77,0,0,0"/>
                                <TextBlock Text="عنوان نشریه" Style="{StaticResource HeaderTextStyle}" Margin="0,-2,0,3"/>
                            </Grid>

                            <StackPanel Margin="15,5">
                                <TextBox
                                    x:Name="txtJournalTitle"
                                    materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                    materialDesign:HintAssist.FloatingScale="1"
                                    IsReadOnly="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- دوره و شماره -->
                        <StackPanel Margin="0,8">
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <Border Style="{StaticResource HeaderLineStyle}" Margin="77,0,0,0"/>
                                <TextBlock Text="دوره و شماره" Style="{StaticResource HeaderTextStyle}" Margin="0,-2,0,3"/>
                            </Grid>

                            <StackPanel Margin="15,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="txtVolume"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="دوره"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox
                                        x:Name="txtIssue"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="شماره"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- فصل و سال -->
                        <StackPanel Margin="0,8">
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <Border Style="{StaticResource HeaderLineStyle}" Margin="77,0,0,0"/>
                                <TextBlock Text="فصل و سال" Style="{StaticResource HeaderTextStyle}" Margin="0,-2,0,3"/>
                            </Grid>

                            <StackPanel Margin="15,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="cmbSeason"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="فصل"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="بهار"/>
                                        <ComboBoxItem Content="تابستان"/>
                                        <ComboBoxItem Content="پاییز"/>
                                        <ComboBoxItem Content="زمستان"/>
                                    </ComboBox>
                                    <TextBox
                                        x:Name="txtYear"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="سال"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- تاریخ‌ها -->
                        <StackPanel Margin="0,8">
                            <Grid Style="{StaticResource SectionHeaderStyle}">
                                <Border Style="{StaticResource HeaderLineStyle}" Margin="77,0,0,0"/>
                                <TextBlock Text="تاریخ‌ها" Style="{StaticResource HeaderTextStyle}" Margin="0,-2,0,3"/>
                            </Grid>

                            <StackPanel Margin="15,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="txtReceivedDate"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="تاریخ دریافت"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox
                                        x:Name="txtAcceptedDate"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                        materialDesign:HintAssist.FloatingScale="1"
                                        materialDesign:HintAssist.Hint="تاریخ پذیرش"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- دکمه تأیید -->
                        <Button
                            x:Name="btnConfirm"
                            Height="42"
                            Margin="15,10,15,10"
                            Background="{StaticResource PrimaryBackgroundColor}"
                            Content="تأیید"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource LightButtonTextColor}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Click="BtnConfirm_Click" />

                        <!-- وضعیت -->
                        <TextBlock
                            x:Name="lblStatus"
                            FontSize="12"
                            Foreground="#FF9800"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            Text="لطفاً اطلاعات را وارد کنید"/>

                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
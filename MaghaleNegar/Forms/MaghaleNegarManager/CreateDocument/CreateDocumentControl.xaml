<UserControl
    x:Class="MaghaleNegar.Forms.MaghaleNegarManager.CreateDocument.CreateDocumentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaghaleNegar.Forms.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MaghaleNegar.Forms.MaghaleNegarManager.CreateDocument"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="600"
    d:DesignWidth="800"
    FlowDirection="RightToLeft"
    FontFamily="Vazirmatn"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10">
        <Grid Name="panelMain">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ====== سه اسلاید ====== -->
            <materialDesign:Transitioner
                x:Name="transitionCreateDocument"
                Grid.Row="2"
                AutoApplyTransitionOrigins="True"
                SelectedIndex="0">

                <!-- اسلاید 1: مشخصات مقاله -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.OpeningEffects>
                        <materialDesign:TransitionEffect Kind="FadeIn" />
                    </materialDesign:TransitionerSlide.OpeningEffects>
                    <local:CreateDocumentSlide3 x:Name="createDocumentSlide3" />
                </materialDesign:TransitionerSlide>

                <!-- اسلاید 2: وابستگی علمی -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.OpeningEffects>
                        <materialDesign:TransitionEffect Kind="FadeIn" />
                    </materialDesign:TransitionerSlide.OpeningEffects>
                    <local:CreateDocumentSlide5 x:Name="createDocumentSlide5" />
                </materialDesign:TransitionerSlide>

                <!-- اسلاید 3: تأیید نهایی + ایجاد مقاله -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.OpeningEffects>
                        <materialDesign:TransitionEffect Kind="FadeIn" />
                    </materialDesign:TransitionerSlide.OpeningEffects>
                    <local:CreateDocumentSlide6 x:Name="createDocumentSlide6" />
                </materialDesign:TransitionerSlide>

            </materialDesign:Transitioner>

            <!-- هدر -->
            <Grid
                x:Name="gridHeader"
                Grid.Row="0"
                materialDesign:ElevationAssist.Elevation="Dp12"
                Background="{StaticResource PrimaryBackgroundColor}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        x:Name="btnExitCreateDocument"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Foreground="White"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="بستن پنجره"
                        Click="BtnExitCreateDocument_Click">
                        <materialDesign:PackIcon Kind="WindowClose" />
                    </Button>

                    <Button
                        x:Name="btnMaximize"
                        Width="30"
                        Height="30"
                        Margin="0,5,5,5"
                        Foreground="White"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="بزرگنمایی پنجره"
                        Click="BtnMaximize_Click">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="WindowMaximize" />
                    </Button>

                    <Button
                        x:Name="btnMinimize"
                        Width="30"
                        Height="30"
                        Margin="0,5,5,5"
                        Foreground="White"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="کوچکنمایی پنجره"
                        Click="BtnMinimize_Click">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="WindowMinimize" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock
                        x:Name="lblVersion"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="نسخه: ۱.۰.۳۰"
                        FontWeight="Bold"
                        Foreground="#BBFFFFFF"
                        TextAlignment="Center" />

                    <ToggleButton
                        Name="toggleButtonAlwaysOnTop"
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FlowDirection="LeftToRight"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                        ToolTip="پنجره Always on Top تنظیم"
                        UseLayoutRounding="False"
                        Click="ToggleButtonAlwaysOnTop_Click">

                        <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin=".5,.5">
                            <materialDesign:PackIcon.RenderTransform>
                                <RotateTransform Angle="45" />
                            </materialDesign:PackIcon.RenderTransform>
                        </materialDesign:PackIcon>

                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Foreground="{StaticResource LightBackgroundColor}" Kind="Pin" />
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- نوار پیشرفت -->
            <Grid
                Grid.Row="1"
                Height="65"
                Background="{StaticResource PrimaryBackgroundColor}">
                <controls:WizardProgressBar
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource LightButtonTextColor}"
                    ItemsSource="{Binding Steps}"
                    Progress="{Binding Progress}"
                    SnapsToDevicePixels="True" />
            </Grid>

        </Grid>
    </Border>
</UserControl>
<UserControl
        x:Class="MaghaleNegar.Forms.MaghaleNegarManager.CreateDocument.CreateDocumentSlide3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="600"
        d:DesignWidth="800"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn"
        mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MaghaleNegar;component/Forms/Styles/MainDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- استایل برای خط جداکننده -->
            <Style x:Key="SectionSeparator" TargetType="Separator">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Margin" Value="0,10,0,15"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}"/>
                <Setter Property="Opacity" Value="0.3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="0,0,10,10">
        <Grid x:Name="gridMain">
            <Grid.RowDefinitions>
                <RowDefinition Height="351*" />
                <RowDefinition Height="184*"/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                    x:Name="scrollContent"
                    Grid.Row="0"
                    Margin="0,10,0,0"
                    VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">

                <StackPanel
                        x:Name="stackContent"
                        Margin="20,0,20,20"
                        Orientation="Vertical">

                    <!-- ========================================== -->
                    <!-- بخش ۱: اطلاعات مقاله -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش -->
                    <TextBlock 
                            Text="📄 اطلاعات مقاله"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- نام نشریه -->
                    <ComboBox
        x:Name="cmbJournalName"
        Margin="5,0,5,15"
        materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
        materialDesign:HintAssist.FloatingScale="1"
        materialDesign:HintAssist.Hint="انتخاب نشریه"
        Style="{StaticResource MaterialDesignOutlinedComboBox}"
        SelectedIndex="0">
                        <ComboBoxItem Content="نشریه علمی ابتکار و خلاقیت در علوم انسانی" />
                        <ComboBoxItem Content="رویکرد الهی ـ فرهنگی در تدریس" />
                        <ComboBoxItem Content="جستارنامه ادبیات تطبیقی" />
                        <ComboBoxItem Content="پژوهش های بازاریابی اسلامی" />
                        <ComboBoxItem Content="International Journal of Applied Arts Studies" />
                        <ComboBoxItem Content="The Journal of Radar and Optical Remote Sensing" />
                        <ComboBoxItem Content="The Iranian Journal of Textile Nano-bio Modification (IJTNBM)" />
                        <ComboBoxItem Content="Artificial Intelligence Tools in Software and Data Engineering (AITSDE)" />
                    </ComboBox>

                    <!-- نام مقاله -->
                    <Grid x:Name="gridFieldOfStudy" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxFieldOfStudy"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام مقاله"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" />
                        <TextBox
                                Name="txtBoxFieldOfStudyEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام مقاله (انگلیسی)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" />
                    </Grid>

                    <!-- خط جداکننده بین بخش مقاله و نویسنده -->
                    <Separator Style="{StaticResource SectionSeparator}" />

                    <!-- ========================================== -->
                    <!-- بخش ۲: اطلاعات نویسنده -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش -->
                    <TextBlock 
                            Text="👤 اطلاعات نویسنده"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- نام نویسنده -->
                    <Grid x:Name="gridAreaOfStudy" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxAreaOfStudy"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام نویسنده"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="Persian"
                                TextWrapping="Wrap" />
                        <TextBox
                                Name="txtBoxAreaOfStudyEn"
                                Grid.Column="1"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="نام نویسنده (انگلیسی)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" />
                    </Grid>

                    <!-- ایمیل -->
                    <Grid x:Name="gridEmail" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                                Name="txtBoxEmail"
                                Grid.Column="0"
                                Margin="5"
                                materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                                materialDesign:HintAssist.FloatingScale="1"
                                materialDesign:HintAssist.Hint="ایمیل (اختیاری)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Tag="English"
                                TextWrapping="Wrap" />

                        <TextBox 
                            Name="txtBoxOrcid"
                            Grid.Column="1"
                            Margin="5"
                            materialDesign:HintAssist.Background="{StaticResource LightBackgroundColor}"
                            materialDesign:HintAssist.FloatingScale="1"
                            materialDesign:HintAssist.Hint="شناسه ارکید (ORCID)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Tag="English"
                            TextWrapping="Wrap"
                            />
                    </Grid>

                    <!-- نویسنده مسئول -->
                    <Grid x:Name="gridResponsibleAuthor" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                                Name="chkResponsibleAuthor"
                                Margin="5"
                                Content="نویسنده مسئول"
                                FontSize="14"
                                FlowDirection="RightToLeft" />
                    </Grid>

                    <!-- دکمه‌ها -->
                    <Grid x:Name="gridAddAuthor" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                                x:Name="btnAddAuthor"
                                Grid.Column="0"
                                Height="40"
                                Margin="5"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="{StaticResource PrimaryBackgroundColor}"
                                Content="➕ افزودن به لیست نویسندگان"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                Click="btnAddAuthor_Click" />

                        <!-- دکمه انصراف از ویرایش -->
                        <Button
                                x:Name="btnCancelEdit"
                                Grid.Column="1"
                                Height="40"
                                Margin="5"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#FF9800"
                                Content="❌ انصراف از ویرایش"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="btnCancelEdit_Click" />
                    </Grid>


                    <!-- ========================================== -->
                    <!-- بخش ۳: لیست نویسندگان -->
                    <!-- ========================================== -->

                    <!-- عنوان بخش با شمارنده نویسندگان -->
                    <TextBlock 
                            Text="📋 لیست نویسندگان"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBackgroundColor}"
                            Margin="5,0,5,10" />

                    <!-- DataGrid نویسندگان -->
                    <Grid x:Name="gridAuthors" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid
                                x:Name="dgAuthors"
                                Margin="5"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="True"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                MaxHeight="200"
                                MinHeight="80"
                                GridLinesVisibility="Horizontal"
                                AlternatingRowBackground="#F5F5F5"
                                RowHeight="35"
                                FontSize="13"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                Background="White">

                            <DataGrid.Columns>
                                <!-- ستون نام نویسنده (فارسی) -->
                                <DataGridTextColumn 
                                        Binding="{Binding Name}" 
                                        Header="نام نویسنده" 
                                        Width="2*" />

                                <!-- ستون نام نویسنده (انگلیسی) -->
                                <DataGridTextColumn 
                                        Binding="{Binding NameEn}" 
                                        Header="نام نویسنده (انگلیسی)" 
                                        Width="2*" />

                                <!-- ستون ایمیل -->
                                <DataGridTextColumn 
                                        Binding="{Binding Email}" 
                                        Header="ایمیل" 
                                        Width="2*" />


                                <DataGridTextColumn
                                    Binding="{Binding Orcid}"
                                    Header="ORCID"
                                    Width="2*" />

                                <!-- ستون نویسنده مسئول -->
                                <DataGridCheckBoxColumn 
                                        Binding="{Binding IsResponsible}" 
                                        Header="نویسنده مسئول" 
                                        Width="Auto" 
                                        MinWidth="100" />
                                <DataGridTemplateColumn Header="عملیات" Width="Auto" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                                                <!-- ویرایش -->
                                                <Button
                    Width="30"
                    Height="30"
                    Margin="0,0,3,0"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="ویرایش نویسنده"
                    Click="btnEditAuthor_Click"
                    Tag="{Binding}"
                    IsEnabled="{Binding IsEditingMode, FallbackValue=True}" />

                                                <!-- حذف -->
                                                <Button
                    Width="30"
                    Height="30"
                    Background="#FF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="حذف نویسنده"
                    Click="btnDeleteAuthor_Click"
                    Tag="{Binding}" />

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- دکمه‌های جلو و عقب -->
            <Grid x:Name="gridTransitionButtons" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                        x:Name="btnForward"
                        Grid.Column="1"
                        Height="45"
                        Margin="10"
                        VerticalAlignment="Bottom"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        Content="بعدی"
                        Foreground="{StaticResource LightButtonTextColor}"
                        IsEnabled="False" />

            </Grid>

        </Grid>
    </Border>
</UserControl>